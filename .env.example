# easyol KOL 控制台 · 配置样例
# 复制为 .env 后填写，或直接运行 `npm run setup` 交互式生成。
# 每个用户使用自己的飞书表格与邮箱；.env 已被 .gitignore，请勿提交。

# ── 飞书多维表格（必填，每个用户各自的表） ───────────────────────────────────
# 从浏览器打开你的多维表格，URL 里可取到 table / view；
# 常规链接 .../base/<这一段就是 base token>?table=...&view=...
LARK_BASE_TOKEN=
LARK_TABLE_ID=
LARK_VIEW_ID=
# “打开飞书表格”按钮跳转的链接，直接填你浏览器里的那条 URL
FEISHU_TABLE_URL=

# ── 你的身份（必填） ─────────────────────────────────────────────────────────
# 你的飞书邮箱，用于区分邮件里的“我方”和“KOL”。可逗号分隔多个地址。
OWNER_EMAIL=

# ── 团队品牌（可选，默认 Bloome） ────────────────────────────────────────────
# 用于邮件主题和 AI 提示词，例如 Bloome 或 Renoise。
BRAND=Bloome

# ── 服务（可选） ─────────────────────────────────────────────────────────────
PORT=4173

# ── AI 工具（可选，二者至少装一个） ──────────────────────────────────────────
# 默认从 PATH 找 `claude` / `codex`；装在非标准位置时填绝对路径。
# macOS 上 Codex 应用的常见路径示例：
# CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex
CLAUDE_BIN=
CODEX_BIN=

# ── 其他可选 ─────────────────────────────────────────────────────────────────
# 创建飞书邮件草稿后“在飞书中查看”的回退链接
# FEISHU_MAIL_URL=https://mail.feishu.cn/mail/inbox
